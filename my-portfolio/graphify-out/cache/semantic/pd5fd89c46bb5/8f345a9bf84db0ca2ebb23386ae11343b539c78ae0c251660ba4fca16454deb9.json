{"nodes": [{"id": "index_app_shell", "label": "index.html app shell", "file_type": "code", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_page_loader", "label": "Page loader (typed name + Type cursor)", "file_type": "code", "source_file": "index.html", "source_location": "L31-L90, L112-L150", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Self-contained inline CSS/JS so it paints before the app bundle arrives; the name lifts toward the nav while project cards fly in."}, {"id": "index_tick", "label": "tick()", "file_type": "code", "source_file": "index.html", "source_location": "L139", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses setTimeout, not requestAnimationFrame: rAF stops in background tabs and would hold the loader until the tab is shown."}, {"id": "index_finish", "label": "finish()", "file_type": "code", "source_file": "index.html", "source_location": "L131", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Waits for .nav, which only the app renders; #root alone is no signal because it already holds the static fallback."}, {"id": "index_seo_head_placeholder", "label": "<!--seo:head--> build-time SEO placeholder (search-pages plugin)", "file_type": "code", "source_file": "index.html", "source_location": "L11-L13", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_self_hosted_fonts", "label": "Self-hosted fonts (Inter, Instrument Serif)", "file_type": "rationale", "source_file": "index.html", "source_location": "L15-L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fonts are served from public/fonts, not a font service, so no visitor data goes to a third party; Inter 500 is preloaded because the loader uses it."}, {"id": "index_serif_st